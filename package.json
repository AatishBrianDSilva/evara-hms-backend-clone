{
  "name": "evara-backend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev --profile evara",
    "build": "sst build --profile evara",
    "deploy": "sst deploy --profile evara",
    "remove": "sst remove --profile evara",
    "console": "sst console --profile evara",
    "typecheck": "tsc --noEmit",
    "generate-docs": "npx @redocly/cli build-docs docs/api-schema.yaml --config docs/redocly.yaml -o docs/index.html"
  },
  "devDependencies": {
    "sst": "^2.40.6",
    "aws-cdk-lib": "2.124.0",
    "constructs": "10.3.0",
    "typescript": "^5.3.3",
    "@tsconfig/node18": "^18.2.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "mongoose": "^8.0.3"
  }
}
