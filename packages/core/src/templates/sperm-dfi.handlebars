<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0px; font-size:
      13px; /* Reduced font size */ } main { padding: 0; /* Remove top padding
      to ensure content starts at the top */ display: flex; box-sizing:
      border-box; flex-direction: column; flex-grow: 1; } .section {
      margin-bottom: 10px; /* Reduced vertical spacing */ } .section-title {
      font-size: 1.4em; /* Retain font size */ margin-bottom: 5px; /* Reduced
      spacing below title */ color:
      {{styles.primaryColor}}; } .section-content { font-size: 0.9em; /* Reduced
      font size */ } .key-value { display: flex; justify-content: space-between;
      margin-bottom: 5px; /* Reduced spacing between rows */ } .key {
      font-weight: bold; width: 50%; text-align: left; } .value { width: 70%;
      text-align: left; white-space: pre-wrap; } .header { text-align: center;
      font-size: 15px; /* Reduced font size */ font-weight: bold; background:
      #ffece4; height: 40px; /* Reduced height */ line-height: 40px; /*
      Vertically align text */ margin-bottom: 5px; /* Reduced spacing below
      header */ } .column-container { display: flex; justify-content:
      space-between; gap: 20px; /* Retain horizontal spacing */ padding: 0; /*
      Remove vertical padding */ } .column { width: 48%; } .column.left {
      padding-left: 15px; /* Maintain horizontal padding */ } .column.right {
      padding-right: 15px; /* Maintain horizontal padding */ } .branch-address {
      text-align: center; padding: 10px 0; /* Reduced vertical padding */
      font-size: 0.9em; /* Reduced font size */ color: #333; } .image-gallery {
      display: flex; flex-wrap: wrap; gap: 5px; /* Maintain horizontal spacing
      */ justify-content: space-between; } .image-container { width: 31%;
      box-sizing: border-box; margin-bottom: 5px; /* Reduced spacing below
      images */ } .uploaded-image { width: 100%; height: auto; } .image-label {
      text-align: center; font-weight: bold; margin-bottom: 2px; /* Reduced
      spacing below labels */ } table { width: 100%; border-collapse: collapse;
      margin-bottom: 15px; font-size: 0.9em; /* Reduced font size */ } table,
      th, td { border: 1px solid #ccc; } th, td { padding: 4px 8px; /* Reduced
      top/bottom padding */ text-align: left; font-size: 0.9em; /* Retain font
      size */ } th { background: #f9f9f9; font-weight: bold; color: #333; }
    </style>
  </head>

  <body>
    <main>
      <!-- Patient Details Section -->
      <div class='header'>Patient Details</div>
      <div class='section'>
        <div class='column-container'>
          <!-- First column -->
          <div class='column left'>
            <div class='key-value'>
              <span class='key'>Name:</span>
              <span class='value'>{{patientData.name}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>ID:</span>
              <span class='value'>{{patientData.id}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Age:</span>
              <span class='value'>{{patientData.age}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Gender:</span>
              <span class='value'>{{patientData.gender}}</span>
            </div>
          </div>
          <!-- Second column -->
          <div class='column right'>
            <div class='key-value'>
              <span class='key'>Spouse Name:</span>
              <span class='value'>{{patientData.spouseName}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Admission Date:</span>
              <span class='value'>{{patientData.admissionDate}}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Sperm DFI Report Section -->
      <div class='header'>SPERM DFI REPORT</div>
      <div class='section padded-section' style='margin-top: 10px;'>
        <table>
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Abstinence Period</td>
              <td>{{spermDFIData.abstinencePeriod}}</td>
            </tr>
            <tr>
              <td>No. of Sperms Evaluated</td>
              <td>{{spermDFIData.spermEvaluated}}</td>
            </tr>
            <tr>
              <td>Sperms with Normal HALO</td>
              <td>{{spermDFIData.normalHalo}}</td>
            </tr>
            <tr>
              <td>Sperms with NO/ABNORMAL HALO</td>
              <td>{{spermDFIData.noAbnormalHalo}}</td>
            </tr>
            <tr>
              <td>DNA Fragmentation Index (DFI%)</td>
              <td>{{spermDFIData.dfiIndex}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Additional Information -->
        <table>
          <tbody>
            <tr>
              <th>Image Description</th>
              <td>{{spermDFIData.imageDescription}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Normal Reference Value/Range for DFI Index -->
        <table>
          <tbody>
            <tr>
              <td>
                <b>Normal Reference Value/Range for DFI Index:</b>
                <br />
                Normal: DFI
                <br />
                Equivocal: DFI ≥ 15% TO ≤ 25%
                <br />
                Abnormal: DFI > 25%
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Uploaded Images Section -->
      {{#if uploadedImages}}
        <div class='header'>Uploaded Images</div>
        <div class='section'>
          <div class='image-gallery'>
            {{#each uploadedImages}}
              <div class='image-container'>
                <p class='image-label'>{{label}}</p>
                <img src='{{url}}' alt='{{label}}' class='uploaded-image' />
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}

      <!-- Prepared By and Checked By -->
      <div class='section'>
        <div class='column-container'>
          <div class='column left'>
            <p>Prepared By</p>
          </div>
          <div class='column right'>
            <p style='text-align: right;'>Checked By</p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>