<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; font-size:
      13px; } main { padding: 0; display: flex; box-sizing: border-box;
      flex-direction: column; flex-grow: 1; } .section { margin-bottom: 5px; /*
      Reduced vertical spacing */ } .section-title { font-size: 1.2em; /*
      Adjusted font size */ margin-bottom: 3px; /* Reduced spacing below title
      */ color:
      {{styles.primaryColor}}; } .section-content { font-size: 1em; } .key-value
      { display: flex; justify-content: space-between; margin-bottom: 3px; /*
      Reduced spacing between rows */ } .key { font-weight: bold; width: 50%;
      text-align: left; } .value { width: 50%; text-align: left; white-space:
      pre-wrap; } h2 { color:
      {{styles.primaryColor}}; text-align: center; } .header { text-align:
      center; font-size: 14px; /* Reduced font size */ font-weight: bold;
      background: #ffece4; height: 20px; /* Reduced height */ line-height: 20px;
      /* Align text vertically */ margin-bottom: 3px; /* Reduced vertical space
      below header */ } .column-container { display: flex; justify-content:
      space-between; gap: 10px; /* Reduced horizontal spacing */ padding: 0; }
      .column { width: 48%; } .padded-section { padding-left: 10px; /* Reduced
      padding */ padding-right: 10px; } .branch-address { text-align: center;
      padding: 5px 0; /* Reduced vertical padding */ font-size: 1em; color:
      #333; } .image-gallery { display: flex; flex-wrap: wrap; gap: 3px; /*
      Reduced spacing between images */ justify-content: space-between; }
      .image-container { width: 31%; box-sizing: border-box; margin-bottom: 3px;
      /* Reduced vertical margin */ } .uploaded-image { width: 100%; height:
      auto; } .image-label { text-align: center; font-weight: bold;
      margin-bottom: 2px; /* Reduced space below label */ }
    </style>
  </head>
  <body>
    <main>
      <!-- Patient Details Section -->
      <div class='header'>Patient Details</div>
      <div class='section'>
        <div class='column-container'>
          <!-- First column -->
          <div class='column left'>
            {{#getSectionByTitle sections 'Patient Details'}}
              {{#each content}}
                {{#if (lt @index 3)}}
                  <div class='key-value'>
                    <span class='key'>{{properCase @key}}</span>
                    <span class='value'>{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
          <!-- Second column -->
          <div class='column right'>
            {{#getSectionByTitle sections 'Patient Details'}}
              {{#each content}}
                {{#if (gte @index 3)}}
                  <div class='key-value'>
                    <span class='key'>{{properCase @key}}</span>
                    <span class='value'>{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
        </div>
      </div>

      <!-- General Information Section -->
      <div class='header'>
        {{capitalizeFirst fileName}}
        Discharge Summary
      </div>
      <div class='section'>
        {{#getSectionByTitle sections 'General Information'}}
          {{#each content}}
            <div class='key-value'>
              <span class='key'>{{properCase @key}}</span>
              <span class='value'>{{this}}</span>
            </div>
          {{/each}}
        {{/getSectionByTitle}}
      </div>

      <!-- Embryo Biopsy Details Section (if exists) -->
      {{#each sections}}
        {{#showIfContainsTitle title 'Embryo Biopsy'}}
          <div class='section'>
            <div class='section-title' style='color: black;'>{{title}}</div>
            <div class='section-content'>
              {{#each content}}
                <div class='key-value'>
                  <span class='key'>{{properCase @key}}</span>
                  <span class='value'>{{this}}</span>
                </div>
              {{/each}}
            </div>
          </div>
        {{/showIfContainsTitle}}
      {{/each}}

      <!-- Uploaded Images Section -->
      {{#getSectionByTitle sections 'Uploaded Images'}}
        <div class='header'>Uploaded Images</div>
        <div class='section'>
          <div class='image-gallery'>
            {{#each content}}
              <div class='image-container'>
                <p class='image-label'>{{label}}</p>
                <img src='{{src}}' alt='{{label}}' class='uploaded-image' />
              </div>
            {{/each}}
          </div>
        </div>
      {{/getSectionByTitle}}
    </main>
  </body>
</html>