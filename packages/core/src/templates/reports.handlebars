<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; } main {
      padding: 0; /* Remove all padding to start content at the top */ display:
      flex; box-sizing: border-box; flex-direction: column; flex-grow: 1; }
      .section { margin-bottom: 10px; /* Reduced vertical margin */ }
      .section-title { font-size: 1.2em; /* Slightly smaller font size */
      margin-bottom: 5px; /* Reduced space below title */ color:
      {{styles.primaryColor}}; } .section-content { font-size: 1em; } .key-value
      { display: flex; justify-content: space-between; margin-bottom: 5px; /*
      Reduced vertical spacing between rows */ } .key { font-weight: bold;
      width: 50%; text-align: left; } .value { width: 70%; text-align: left;
      white-space: pre-wrap; } h2 { color:
      {{styles.primaryColor}}; text-align: center; } .header { text-align:
      center; font-size: 14px; /* Reduced font size */ font-weight: bold;
      background: #ffece4; height: 40px; /* Reduced height */ line-height: 40px;
      /* Align text vertically */ margin-bottom: 5px; /* Reduced vertical space
      below header */ } .column-container { display: flex; justify-content:
      space-between; gap: 20px; /* Maintain horizontal spacing */ padding: 0; /*
      Remove vertical padding */ } .column { width: 48%; } .column.left {
      padding-left: 15px; /* Keep horizontal padding */ } .column.right {
      padding-right: 15px; /* Keep horizontal padding */ } .padded-section {
      padding-left: 15px; /* Maintain horizontal padding */ padding-right: 15px;
      } .branch-address { text-align: center; padding: 10px 0; /* Reduced
      vertical padding */ font-size: 1em; /* Adjust as needed */ color: #333; /*
      Adjust text color as needed */ } /* CSS for uploaded images */
      .image-gallery { display: flex; flex-wrap: wrap; gap: 5px; /* Maintain
      spacing between images */ justify-content: space-between; }
      .image-container { width: 31%; box-sizing: border-box; margin-bottom: 5px;
      /* Reduced vertical margin */ } .uploaded-image { width: 100%; height:
      auto; } .image-label { text-align: center; font-weight: bold;
      margin-bottom: 2px; /* Reduced space below label */ }
    </style>
  </head>
  <body>
    <main>

      <!-- Patient Details Section -->
      <div class='header'>Patient Details</div>
      <div class='section'>
        <div class='column-container'>
          <!-- First column -->
          <div class='column left'>
            {{#getSectionByTitle sections 'Patient Details'}}
              {{#each content}}
                {{#if (lt @index 3)}}
                  <div class='key-value'>
                    <span class='key'>{{properCase @key}}</span>
                    <span class='value'>{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
          <!-- Second column -->
          <div class='column right'>
            {{#getSectionByTitle sections 'Patient Details'}}
              {{#each content}}
                {{#if (gte @index 3)}}
                  <div class='key-value'>
                    <span class='key'>{{properCase @key}}</span>
                    <span class='value'>{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
        </div>
      </div>

      <!-- General Information Section -->
      <div class='header'>
        {{capitalizeFirst fileName}}
        Discharge Summary
      </div>
      <div class='section padded-section'>
        {{#getSectionByTitle sections 'General Information'}}
          {{#each content}}
            <div class='key-value'>
              <span class='key'>{{properCase @key}}</span>
              <span class='value'>{{this}}</span>
            </div>
          {{/each}}
        {{/getSectionByTitle}}
      </div>

      <!-- Embryo Biopsy Details Section (only if exists) -->
      {{#each sections}}
        {{#showIfContainsTitle title 'Embryo Biopsy'}}
          <div class='section padded-section'>
            <div class='section-title' style='color: black;'>{{title}}</div>
            <div class='section-content'>
              {{#each content}}
                <div class='key-value'>
                  <span class='key'>{{properCase @key}}</span>
                  <span class='value'>{{this}}</span>
                </div>
              {{/each}}
            </div>
          </div>
        {{/showIfContainsTitle}}
      {{/each}}

      <!-- Uploaded Images Section -->
      {{#getSectionByTitle sections 'Uploaded Images'}}
        <div class='header'>Uploaded Images</div>
        <!-- Use the same header style -->
        <div class='section'>
          <div class='image-gallery'>
            {{#each content}}
              <div class='image-container'>
                <p class='image-label'>{{label}}</p>
                <img src='{{src}}' alt='{{label}}' class='uploaded-image' />
              </div>
            {{/each}}
          </div>
        </div>
      {{/getSectionByTitle}}
    </main>
  </body>
</html>