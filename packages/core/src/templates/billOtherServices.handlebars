<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style
    >
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; font-size:
      12px; /* Global font size */ } main { padding: 0; display: flex;
      flex-direction: column; flex-grow: 1; margin: 0; box-sizing: border-box; }
      .section { margin-bottom: 5px; /* Reduced vertical margin */ }
      .section-title { font-size: 1.2em; margin-bottom: 5px; color:
      {{styles.primaryColor}}; } .key-value { display: flex; justify-content:
      space-between; margin-bottom: 5px; /* Reduced space between rows */ } .key
      { font-weight: bold; width: 50%; text-align: left; } .value { width: 50%;
      text-align: right; white-space: pre-wrap; } h2 { color:
      {{styles.primaryColor}}; text-align: center; font-size: 16px; } .header {
      text-align: center; font-size: 14px; font-weight: bold; background:
      #ffece4; height: 20px; line-height: 20px; margin-bottom: 5px; }
      .column-container { display: flex; justify-content: space-between; gap:
      15px; padding: 0; } .column.left { width: 50%; padding-left: 15px; }
      .column.right { width: 25%; padding-right: 15px; text-align: left; }
      .column.right .value { text-align: right; } .padded-section {
      padding-left: 15px; padding-right: 15px; } /* Table Styling */ table {
      width: 100%; border-collapse: collapse; margin-bottom: 0px; /* Reduced
      spacing below the table */ } th, td { padding: 6px; text-align: center;
      font-size: 11px; } th { background-color: #f9f9f9; color: black; } td {
      color: black; } td.value { color:
      {{styles.primaryColor}}; } .no-borders { border: none; } /* Column width
      adjustments */ th:nth-child(1), td:nth-child(1) { width: 10%; }
      th:nth-child(2), td:nth-child(2) { width: 70%; text-align: left; }
      th:nth-child(3), td:nth-child(3) { width: 20%; text-align: right; } /*
      Summary Alignment */ .summary-box { width: 35%; margin-left: auto;
      margin-top: 0; /* Removed extra margin above the summary box */ padding:
      5px; box-sizing: border-box; } .summary-key { font-weight: bold;
      text-align: left; padding-right: 10px; width: 50%; font-size: 12px; }
      .summary-value { text-align: right; width: 50%; font-size: 12px; }
      .summary-row { display: flex; justify-content: space-between;
      margin-bottom: 3px; /* Reduced space between summary rows */ }
      .branch-address { text-align: center; padding: 10px 0; font-size: 1em;
      color: #333;  }
       h1.tax-invoice {
        color: grey;
        font-size: 18px;
        font-weight: bold;
        text-align: center;
        text-decoration: underline;
        margin: 10px 0;
      }
    </style>
  </head>
  <body>
    <main>
      <h1 class='tax-invoice'>TAX INVOICE</h1>

      <div class='gst-box'>
        {{#getSectionByTitle sections 'License'}}
          {{#with content}}
            <div class='summary-row'>
              <span class='summary-text'>GSTIN: {{Gstin}}</span>
            </div>
            {{!-- <div class='summary-row'>
              <span class='summary-text'>Drug License Number:
                {{this.[Drug Licence No]}}</span>
            </div> --}}
          {{/with}}
        {{/getSectionByTitle}}
      </div>
      <!-- Patient Details Section -->
      <div class='header'>Patient Details</div>
      <div class='section'>
        <div class='column-container'>
          <!-- First 4 key-value pairs in the left column (50% width) -->
          <div class='column left'>
            {{#getSectionByTitle sections 'Patient Details'}}
              {{#each content}}
                {{#if (lt @index 4)}}
                  <div class='key-value'>
                    <span class='key'>{{properCase @key}}</span>
                    <span class='value'>{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
          <!-- Remaining key-value pairs in the right column (25% width) -->
          <div class='column right'>
            {{#getSectionByTitle sections 'Patient Details'}}
              {{#each content}}
                {{#if (gte @index 4)}}
                  <div class='key-value'>
                    <span class='key'>{{properCase @key}}</span>
                    <span class='value'>{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
        </div>
      </div>

      <!-- Items Section -->
      <div class='header'>Items</div>
      <table class='no-borders'>
        <thead>
          <tr>
            <th>#</th>
            <th>Service Name</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          {{#getSectionByTitle sections 'Items'}}
            {{#each content}}
              <tr>
                <td>{{inc @index}}</td>
                <td>{{this.serviceName}}</td>
                <td>{{formatCurrency this.price}}</td>
              </tr>
            {{/each}}
          {{/getSectionByTitle}}
        </tbody>
      </table>

      <!-- Summary Section -->
      <div class='summary-box'>
        {{#getSectionByTitle sections 'Summary'}}
          {{#each content}}
            <div class='summary-row'>
              <div class='summary-key'>{{properCase @key}}</div>
              <div class='summary-value'>{{this}}</div>
            </div>
          {{/each}}
        {{/getSectionByTitle}}
      </div>
    </main>
  </body>
</html>