<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; font-size:
      13px; /* Decreased font size */ } main { padding: 0; display: flex;
      box-sizing: border-box; flex-direction: column; flex-grow: 1; } .section {
      margin-bottom: 5px; /* Reduced vertical spacing */ } .header { text-align:
      center; font-size: 14px; /* Reduced font size */ font-weight: bold;
      background: #ffece4; height: 18px; /* Reduced height */ line-height: 18px;
      /* Vertically align text */ margin-bottom: 3px; /* Reduced spacing below
      header */ } .column-container { display: flex; justify-content:
      space-between; gap: 10px; /* Reduced horizontal spacing */ } .column {
      width: 48%; } .key-value { display: flex; justify-content: space-between;
      margin-bottom: 3px; /* Reduced spacing between rows */ } .key {
      font-weight: bold; width: 50%; text-align: left; } .value { width: 50%;
      text-align: left; white-space: pre-wrap; } table { width: 100%;
      border-collapse: collapse; margin-bottom: 5px; /* Reduced spacing below
      tables */ font-size: 0.9em; } th, td { border: 1px solid #ccc; padding:
      3px 6px; /* Reduced top/bottom padding */ text-align: left; } th {
      background: #f9f9f9; font-weight: bold; color: #333; }
    </style>
  </head>

  <body>
    <main>
      <!-- Patient Details Section -->
      <div class='header'>Patient Details</div>
      <div class='section'>
        <div class='column-container'>
          <!-- First column -->
          <div class='column'>
            <div class='key-value'>
              <span class='key'>Name:</span>
              <span class='value'>{{patientData.name}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>ID:</span>
              <span class='value'>{{patientData.id}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Age:</span>
              <span class='value'>{{patientData.age}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Gender:</span>
              <span class='value'>{{patientData.gender}}</span>
            </div>
          </div>
          <!-- Second column -->
          <div class='column'>
            <div class='key-value'>
              <span class='key'>Spouse Name:</span>
              <span class='value'>{{patientData.spouseName}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Admission Date:</span>
              <span class='value'>{{patientData.admissionDate}}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Semen Analysis Report Section -->
      <div class='header'>Semen Analysis Report</div>
      <div class='section padded-section'>
        <!-- Sample Details -->
        <table>
          <tbody>
            <tr>
              <th>Sample Collection Date</th>
              <td>{{formatDateIST
                  semenAnalysisData.sampleCollectionDate
                  'dd-MM-yyyy'
                }}</td>
            </tr>
            <tr>
              <th>Sample Collection Time</th>
              <td>{{formatTimeIST
                  semenAnalysisData.sampleCollectionTime
                  'hh:mm a'
                }}</td>
            </tr>
            <tr>
              <th>Sample Receiving Date</th>
              <td>{{formatDateIST
                  semenAnalysisData.sampleReceivingDate
                  'dd-MM-yyyy'
                }}</td>
            </tr>
            <tr>
              <th>Sample Receiving Time</th>
              <td>{{formatTimeIST
                  semenAnalysisData.sampleReceivingTime
                  'hh:mm a'
                }}</td>
            </tr>
            <tr>
              <th>Sample Tested</th>
              <td>{{semenAnalysisData.sampleTested}}</td>
            </tr>
            <tr>
              <th>Sample Collection Location</th>
              <td>{{semenAnalysisData.sampleCollectionLocation}}</td>
            </tr>
            <tr>
              <th>Spillage Report</th>
              <td>{{semenAnalysisData.spillageReport}}</td>
            </tr>
            <tr>
              <th>Liquefaction</th>
              <td>{{semenAnalysisData.liquefaction}}</td>
            </tr>
            <tr>
              <th>Liquefaction Time</th>
              <td>{{formatTimeIST
                  semenAnalysisData.liquefactionTime
                  'hh:mm a'
                }}</td>
            </tr>
          </tbody>
        </table>

        <!-- Parameters -->
        <table>
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sperm Concentration (million/ml)</td>
              <td>{{semenAnalysisData.spermConcentration}}</td>
              <td>>=16</td>
            </tr>
          </tbody>
        </table>

        <!-- Motility -->
        <table>
          <thead>
            <tr>
              <th>Motility</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sperm Motility Total (%)</td>
              <td>{{semenAnalysisData.spermMotilityTotal}}</td>
              <td>>=42</td>
            </tr>
            <tr>
              <td>Progressive PR (%)</td>
              <td>{{semenAnalysisData.progressivePR}}</td>
              <td>>=30</td>
            </tr>
          </tbody>
        </table>

        <!-- Morphology -->
        <table>
          <thead>
            <tr>
              <th>Morphology</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Normal Forms (%)</td>
              <td>{{semenAnalysisData.normalForms}}</td>
              <td>>=4</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Prepared By and Checked By -->
      <div class='section'>
        <div class='column-container'>
          <div class='column'>
            <p>Prepared By</p>
          </div>
          <div class='column'>
            <p style='text-align: right;'>Checked By</p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>