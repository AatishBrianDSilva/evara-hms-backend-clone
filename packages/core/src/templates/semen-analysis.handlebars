<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
      .thin-divider { border-bottom-width: 1px; } main { padding: 10mm;
      padding-top: 5px; display: flex; box-sizing: border-box; flex-direction:
      column; flex-grow: 1; } .section { margin-bottom: 20px; } .section-title {
      font-size: 1.5em; margin-bottom: 10px; color:
      {{styles.primaryColor}}; } .section-content { font-size: 1em; } .key-value
      { display: flex; justify-content: space-between; margin-bottom: 10px; }
      .key { font-weight: bold; width: 50%; text-align: left; } .value { width:
      70%; text-align: left; white-space: pre-wrap; } h2 { color:
      {{styles.primaryColor}}; text-align: center; } .header { text-align:
      center; font-size: 18px; font-weight: bold; background: #ffece4; height:
      55px; display: flex; justify-content: center; align-items: center;
      margin-bottom: 10px; } .column-container { display: flex; justify-content:
      space-between; padding: 10px 0; gap: 20px; } .column { width: 48%; }
      .column.left { padding-left: 15px; } .column.right { padding-right: 15px;
      } .padded-section { padding-left: 15px; padding-right: 15px; }
      .branch-address { text-align: center; padding: 20px 0; font-size: 1em;
      color: #333; } /* CSS for uploaded images */ .image-gallery { display:
      flex; flex-wrap: wrap; gap: 5px; justify-content: space-between; }
      .image-container { width: 31%; box-sizing: border-box; margin-bottom:
      10px; } .uploaded-image { width: 100%; height: auto; } .image-label {
      text-align: center; font-weight: bold; margin-bottom: 5px; } /* Basic
      table styling */ table { width: 100%; border-collapse: collapse;
      margin-bottom: 15px; } table, th, td { border: 1px solid #ccc; } th, td {
      padding: 8px; text-align: left; font-size: 0.9em; } th { background:
      #f9f9f9; font-weight: bold; color: #333; }

    </style>
  </head>

  <body>
    <main>

      <!-- Patient Details Section -->
      <div class='header'>Patient Details</div>
      <div class='section'>
        <div class='column-container'>
          <!-- First column -->
          <div class='column left'>
            
            <div class='key-value'>
              <span class='key'>Name:</span>
              <span class='value'>{{patientData.name}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>ID:</span>
              <span class='value'>{{patientData.id}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Age:</span>
              <span class='value'>{{patientData.age}}</span>
            </div>
            <div class='key-value'>
              <span class='key'>Gender:</span>
              <span class='value'>{{patientData.gender}}</span>
            </div>
          </div>
          <!-- Second column -->
          <div class='column right'>
            <div class='key-value'>
              <span class='key'>Spouse Name:</span>
              <span class='value'>{{patientData.spouseName}}</span>
            </div>
            <div class='key-value'></div>
              <span class='key'>Admission Date:</span>
              <span class='value'>{{patientData.admissionDate}}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Semen Analysis Report Section -->
      <div class='header'>SEMEN ANALYSIS REPORT</div>
      <div class='section padded-section' style='margin-top: 10px;'>

        <table>
          <tbody>
            <tr>
              <th>Sample Collection Date</th>
              <td>{{formatDateIST
                  semenAnalysisData.sampleCollectionDate
                  'dd-MM-yyyy'
                }}</td>
            </tr>
            <tr>
              <th>Sample Collection Time</th>
              <td>{{formatTimeIST
                  semenAnalysisData.sampleCollectionTime
                  'hh:mm a'
                }}</td>
            </tr>
            <tr>
              <th>Sample Receiving Date</th>
              <td>{{formatDateIST
                  semenAnalysisData.sampleReceivingDate
                  'dd-MM-yyyy'
                }}</td>
            </tr>
            <tr>
              <th>Sample Receiving Time</th>
              <td>{{formatTimeIST
                  semenAnalysisData.sampleReceivingTime
                  'hh:mm a'
                }}</td>
            </tr>
            <tr>
              <th>Sample Tested</th>
              <td>{{semenAnalysisData.sampleTested}}</td>
            </tr>
            <tr>
              <th>Sample Collection Location</th>
              <td>{{semenAnalysisData.sampleCollectionLocation}}</td>
            </tr>
            <tr>
              <th>Spillage Report</th>
              <td>{{semenAnalysisData.spillageReport}}</td>
            </tr>
            <tr>
              <th>Liquefaction</th>
              <td>{{semenAnalysisData.liquefaction}}</td>
            </tr>
            <tr>
              <th>Liquefaction Time</th>
              <td>{{formatTimeIST
                  semenAnalysisData.liquefactionTime
                  'hh:mm a'
                }}</td>
            </tr>
            <tr>
              <th>Viscosity</th>
              <td>{{semenAnalysisData.viscosity}}</td>
            </tr>
            <tr>
              <th>Abstinence</th>
              <td>{{semenAnalysisData.abstinence}}</td>
            </tr>
            <tr>
              <th>Volume (ml)</th>
              <td>{{semenAnalysisData.volume}}</td>
            </tr>
            <tr>
              <th>pH</th>
              <td>{{semenAnalysisData.ph}}</td>
            </tr>
            <tr>
              <th>Visual Appearance</th>
              <td>{{semenAnalysisData.visualAppearance}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Parameters -->
        <table>
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sperm Concentration (million/ml)</td>
              <td>{{semenAnalysisData.spermConcentration}}</td>
              <td>>=10</td>
            </tr>
          </tbody>
        </table>

        <!-- Motility Section -->
        <table>
          <thead>
            <tr>
              <th>Motility</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sperm Motility Total (PR + NPR) (%)</td>
              <td>{{semenAnalysisData.spermMotilityTotal}}</td>
              <td>>=42</td>
            </tr>
            <tr>
              <td>Progressive PR (%)</td>
              <td>{{semenAnalysisData.progressivePR}}</td>
              <td>>=30</td>
            </tr>
            <tr>
              <td>Slow Progressive (%)</td>
              <td>{{semenAnalysisData.slowProgressive}}</td>
            </tr>
            <tr>
              <td>Rapid Progressive (%)</td>
              <td>{{semenAnalysisData.rapidProgressive}}</td>
            </tr>
            <tr>
              <td>Non Progressive (%)</td>
              <td>{{semenAnalysisData.nonProgressive}}</td>
              <td></td>
            </tr>
            <tr>
              <td>Immotile (%)</td>
              <td>{{semenAnalysisData.immotile}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Morphology Section -->
        <table>
          <thead>
            <tr>
              <th>Morphology</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Normal Forms (%)</td>
              <td>{{semenAnalysisData.normalForms}}</td>
              <td>>=4</td>
            </tr>
            <tr>
              <td>Head Defects (%)</td>
              <td>{{semenAnalysisData.headDefects}}</td>
            </tr>
            <tr>
              <td>Mid Piece Defects (%)</td>
              <td>{{semenAnalysisData.midPieceDefects}}</td>
            </tr>
            <tr>
              <td>Tail Defects (%)</td>
              <td>{{semenAnalysisData.tailDefects}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Total Ejaculate Section -->
        <table>
          <thead>
            <tr>
              <th>Total Ejaculate</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Total Sperm Count (million/ejaculate)</td>
              <td>{{semenAnalysisData.totalSpermCount}}</td>
              <td>>=39</td>
            </tr>
            <tr>
              <td>Motile Sperm (million/ejaculate)</td>
              <td>{{semenAnalysisData.motileSperm}}</td>
            </tr>
            <tr>
              <td>Morphologically Normal Sperm (million/ejaculate)</td>
              <td>{{semenAnalysisData.morphologicallyNormalSperm}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Additional Information Section -->
        <table>
          <thead>
            <tr>
              <th>Additional Information</th>
              <th>Result</th>
              <th>Reference Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Debris</td>
              <td>{{semenAnalysisData.debris}}</td>
            </tr>
            <tr>
              <td>Round Cells (million/ml)</td>
              <td>{{semenAnalysisData.roundCells}}</td>
              <td></td>
            </tr>
            <tr>
              <td>Agglutination</td>
              <td>{{semenAnalysisData.agglutination}}</td>
            </tr>
            <tr>
              <td>Aggregration</td>
              <td>{{semenAnalysisData.aggregration}}</td>
            </tr>
            <tr>
              <td>Fructose</td>
              <td>{{semenAnalysisData.fructose}}</td>
              <td>Present</td>
            </tr>
            <tr>
              <td>Peroxidase-Positive Cells Concentration (million/ml)</td>
              <td>{{semenAnalysisData.proxidosePositiveCellConcentration}}</td>
            </tr>
          </tbody>
        </table>

        <!-- Impression/Remarks/Advice -->
        <table>
          <tbody>
            <tr>
              <th>Impression</th>
              <td>{{semenAnalysisData.impression}}</td>
            </tr>
            <tr>
              <th>Remarks</th>
              <td>{{semenAnalysisData.remarks}}</td>
            </tr>
            <tr>
              <th>Advice</th>
              <td>{{semenAnalysisData.advice}}</td>
            </tr>
          </tbody>
        </table>

      </div>

      {{! Prepared By and Checked By }}
      <div class='section'>
        <div class='column-container'>
          <div class='column left'>
            <p>Prepared By</p>
          </div>
          <div class='column right'>
            <p style='text-align: right;'>Checked By</p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>