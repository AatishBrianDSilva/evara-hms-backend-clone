<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      font-size: 12px;
      /* Reduced
      global font size */
    }

    main {
      padding: 10mm;
      display: flex;
      flex-direction: column;
      flex-grow:
        1;
      margin-top: 5px;
      box-sizing: border-box;
    }

    .section {
      margin-bottom: 5px;
    }

    .key-value {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .key {
      font-weight:
        bold;
      width: 50%;
      text-align: left;
    }

    .value {
      width: 50%;
      text-align: right;
      /* Right align
      values */
      white-space: pre-wrap;
    }

    h2 {
      color: {
          {
          styles.primaryColor
        }
      }

      ;
      text-align: center;
      font-size: 16px;
      /* Reduced font size for h2 */
    }

    /* Updated Header Styling */
    .header {
      text-align: center;
      font-size: 16px;
      /* Reduced font
      size for header */
      font-weight: bold;
      background: #ffece4;
      /* Light off-white background */
      height: 55px;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom:
        10px;
    }

    .column-container {
      display: flex;
      justify-content: space-between;
      /* Keep space
      between columns */
      padding: 10px 0;
      gap: 20px;
    }

    .column.left {
      width: 50%;
      /* First column
      width */
      padding-left: 15px;
    }

    .column.right {
      width: 25%;
      /* Updated second column width */
      padding-right: 15px;
      text-align: left;
      /* Keep keys left aligned */
    }

    .column.right .value {
      text-align: right;
      /* Right align values in the right column */
    }

    /* Table Styling */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
      /* Added padding after table */
    }

    th,
    td {
      padding: 6px;
      /* Reduced padding for table items */
      text-align: center;
      /* Center
      alignment for table items */
      font-size: 11px;
      /* Reduced font size for table */
    }

    th {
      background-color: #f9f9f9;
      /* Light off-white background */
      color: black;
      /* Black text */
    }

    td {
      color: black;
      word-wrap: break-word;
      word-break: break-word;
      white-space: normal;
    }

    td.value {
      color: {
          {
          styles.primaryColor
        }
      }

      ;
    }

    .no-borders {
      border: none;
    }

    /* Updated Column width adjustments
      */
    th:nth-child(1),
    td:nth-child(1) {
      width: 5%;
      /* Narrow width for # column */
    }

    th:nth-child(2),
    td:nth-child(2) {
      width: 20%;
      /* Wide width for Drug Details column */
      text-align: left;
    }

    th:nth-child(3),
    td:nth-child(3),
    th:nth-child(4),
    td:nth-child(4),
    th:nth-child(5),
    td:nth-child(5),
    th:nth-child(6),
    td:nth-child(6),
    th:nth-child(7),
    td:nth-child(7),
    th:nth-child(8),
    td:nth-child(8),
    th:nth-child(9),
    td:nth-child(9) {
      width:
        11%;
      /* Small width for the remaining columns */
    }

    /* Summary Alignment */
    .summary-box {
      width: 35%;
      /* Updated width for summary box */
      margin-left: auto;
      padding: 10px;
      box-sizing:
        border-box;
    }

    .summary-key {
      font-weight: bold;
      text-align: left;
      padding-right: 10px;
      width:
        50%;
      font-size: 12px;
      /* Adjusted summary key font size */
    }

    .summary-value {
      text-align:
        right;
      width: 50%;
      font-size: 12px;
      /* Adjusted summary value font size */
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .branch-address {
      text-align: center;
      padding: 20px 0;
      font-size: 1em;
      /* Adjust as needed */
      color: #333;
      /*
      Adjust text color as needed */
    }
  </style>
</head>

<body>
  <main>

    {{#if addressData}}
    <div class="section branch-address">
      {{addressData.branchAddress}}
    </div>
    {{/if}}
    <div class="section" style="margin-bottom: 10px">
      {{#getSectionByTitle sections "License"}}
      {{#each content}}
      <div style="display: flex; align-items: center; justify-content: flex-start; margin: 0;">
        <span style="font-weight:bold; margin-right: 15px;">{{toUpperCase @key}}:</span>
        <span style="text-align: left;">{{this}}</span>
      </div>
      {{/each}}
      {{/getSectionByTitle}}
    </div> <!-- Bill of Supply Section -->
    <div class="header">BILL OF SUPPLY</div>

    <!-- Patient Details Section -->
    <div class="section">
      <div class="column-container">
        <!-- First 4 key-value pairs in the left column -->
        <div class="column left">
          {{#getSectionByTitle sections "Patient Details"}}
          {{#each content}}
          {{#if (lt @index 4)}}
          <div class="key-value">
            <span class="key">{{properCase @key}}</span>
            <span class="value">{{this}}</span>
          </div>
          {{/if}}
          {{/each}}
          {{/getSectionByTitle}}
        </div>
        <!-- Remaining key-value pairs in the right column -->
        <div class="column right">
          {{#getSectionByTitle sections "Patient Details"}}
          {{#each content}}
          {{#if (gte @index 4)}}
          <div class="key-value">
            <span class="key">{{properCase @key}}</span>
            <span class="value">{{this}}</span>
          </div>
          {{/if}}
          {{/each}}
          {{/getSectionByTitle}}
        </div>
      </div>
    </div>

    <!-- Items Section -->
    <div class="header">Items</div>
    <table class="no-borders">
      <thead>
        <tr>
          <th>#</th>
          <th>Drug Details</th>
          <th>Qty</th>
          <th>MRP</th>
          <th>Value</th>
          <th>GST%</th>
          <th>SGST</th>
          <th>CGST</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#getSectionByTitle sections "Items"}}
        {{#each content}}
        <tr>
          <td>{{inc @index}}</td>
          <td style="text-align: left">{{this.serviceName}}</td>
          <td>{{this.quantity}}</td>
          <td>{{formatCurrency this.mrp}}</td>
          <td>{{formatCurrency this.value}}</td>
          <td>{{this.gst}}</td>
          <td>{{formatCurrency this.sgst}}</td>
          <td>{{formatCurrency this.cgst}}</td>
          <td>{{formatCurrency this.amount}}</td>
        </tr>
        {{/each}}
        {{/getSectionByTitle}}
      </tbody>
    </table>

    <!-- Summary Section -->
    <div class="summary-box">
      {{#getSectionByTitle sections "Summary"}}
      {{#each content}}
      <div class="summary-row">
        <div class="summary-key">{{properCase @key}}</div>
        <div class="summary-value">{{this}}</div>
      </div>
      {{/each}}
      {{/getSectionByTitle}}
    </div>

  </main>
</body>

</html>