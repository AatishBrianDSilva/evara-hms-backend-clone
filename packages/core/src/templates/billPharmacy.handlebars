<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; } main { padding: 10mm; display:
      flex; flex-direction: column; flex-grow: 1; } .section { margin-bottom: 20px; } .key-value {
      display: flex; justify-content: space-between; margin-bottom: 10px; } .key { font-weight:
      bold; width: 50%; text-align: left; } .value { width: 50%; text-align: left; white-space:
      pre-wrap; } h2 { color:
      {{styles.primaryColor}}; text-align: center; } /* Updated Header Styling */ .header {
      text-align: center; font-size: 18px; font-weight: bold; background: #ffece4; /* Light
      off-white background */ height: 55px; display: flex; justify-content: center; align-items:
      center; margin-bottom: 10px; } .column-container { display: flex; justify-content:
      space-between; padding: 10px 0; gap: 20px; } .column { width: 48%; } .column.left {
      padding-left: 15px; } .column.right { padding-right: 15px; } /* Table Styling */ table {
      width: 100%; border-collapse: collapse; margin-bottom: 30px; /* Added padding after table */ }
      th, td { padding: 8px; text-align: center; /* Center alignment for table items */ } th {
      background-color: #f9f9f9; /* Light off-white background */ color: black; /* Black text */ }
      td { color: black; } td.value { color:
      {{styles.primaryColor}}; } .no-borders { border: none; } /* Summary Alignment */ .summary-box
      { width: 50%; /* Starts at 50% of the page width */ margin-left: auto; padding: 10px;
      box-sizing: border-box; } .summary-key { font-weight: bold; text-align: left; padding-right:
      10px; width: 50%; } .summary-value { text-align: right; width: 50%; } .summary-row { display:
      flex; justify-content: space-between; margin-bottom: 10px; }
    </style>
  </head>
  <body>
    <main>
      <!-- Bill of Supply Section -->
      <div class="header">BILL OF SUPPLY</div>

      <!-- Patient Details Section -->
      <div class="section">
        <div class="column-container">
          <!-- First 4 key-value pairs in the left column -->
          <div class="column left">
            {{#getSectionByTitle sections "Patient Details"}}
              {{#each content}}
                {{#if (lt @index 4)}}
                  <div class="key-value">
                    <span class="key">{{properCase @key}}</span>
                    <span class="value">{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
          <!-- Remaining key-value pairs in the right column -->
          <div class="column right">
            {{#getSectionByTitle sections "Patient Details"}}
              {{#each content}}
                {{#if (gte @index 4)}}
                  <div class="key-value">
                    <span class="key">{{properCase @key}}</span>
                    <span class="value">{{this}}</span>
                  </div>
                {{/if}}
              {{/each}}
            {{/getSectionByTitle}}
          </div>
        </div>
      </div>

      <!-- Items Section -->
      <div class="header">Items</div>
      <table class="no-borders">
        <thead>
          <tr>
            <th>#</th>
            <th>Drug Details</th>
            <th>Qty</th>
            <th>MRP</th>
            <th>Value</th>
            <th>GST%</th>
            <th>SGST</th>
            <th>CGST</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          {{#getSectionByTitle sections "Items"}}
            {{#each content}}
              <tr>
                <td>{{inc @index}}</td>
                <td style="text-align: left">{{this.serviceName}}</td>
                <td>{{this.quantity}}</td>
                <td>{{formatCurrency this.mrp}}</td>
                <td>{{formatCurrency this.value}}</td>
                <td>{{this.gst}}</td>
                <td>{{formatCurrency this.sgst}}</td>
                <td>{{formatCurrency this.cgst}}</td>
                <td>{{formatCurrency this.amount}}</td>
              </tr>
            {{/each}}
          {{/getSectionByTitle}}
        </tbody>
      </table>

      <!-- Summary Section -->
      <div class="summary-box">
        {{#getSectionByTitle sections "Summary"}}
          {{#each content}}
            <div class="summary-row">
              <div class="summary-key">{{properCase @key}}</div>
              <div class="summary-value">{{this}}</div>
            </div>
          {{/each}}
        {{/getSectionByTitle}}
      </div>
    </main>
  </body>
</html>