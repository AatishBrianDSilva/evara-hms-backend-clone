<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; font-size:
      13px; /* Body text font size */ } main { padding: 10mm; padding-top: 0;
      box-sizing: border-box; flex-direction: column; flex-grow: 1; } .section {
      margin-bottom: 3px; /* Reduced spacing between sections */ } .key-value {
      display: flex; justify-content: space-between; margin-bottom: 3px; /*
      Reduced spacing between rows */ } .key { font-weight: bold; width: 50%;
      text-align: left; color: black; } .value { width: 50%; text-align: left;
      white-space: pre-wrap; color: black; } h2 { color:
      {{styles.primaryColor}}; text-align: center; font-size: 14px; /* Header
      font size */ } /* Updated Header Styling */ .header { text-align: center;
      font-size: 14px; /* Header font size */ font-weight: bold; background:
      #ffece4; height: 20px; /* Reduced height */ line-height: 20px; /* Align
      text vertically */ margin-bottom: 3px; /* Reduced spacing below header */
      } /* Table Styling */ table { width: 100%; border-collapse: collapse;
      margin-bottom: 20px; /* Reduced spacing below tables */ } th, td {
      padding: 4px 0; /* Removed left and right padding, reduced top/bottom
      padding */ text-align: left; /* Align text to the left */ font-size: 13px;
      /* Set font size explicitly */ } th { background-color: #f9f9f9; color:
      black; font-size: 13px; /* Ensure consistency with table rows */ } td {
      color: black; font-size: 13px; /* Ensure consistency with table headers */
      } td.value { color:
      {{styles.primaryColor}}; } .no-borders { border: none; } .branch-address {
      text-align: center; padding: 10px 0; /* Reduced vertical padding */
      font-size: 13px; /* Reduced font size */ color: #333; }
    </style>
  </head>
  <body>
    <main>
      <!-- Refund Details Section -->
      <div class='section'>
        <div class='header'>Refund Details</div>
        <div class='section-content'>
          {{#each sections.[0].content}}
            <div class='key-value'>
              <span class='key'>{{properCase @key}}</span>
              <span class='value'>{{this}}</span>
            </div>
          {{/each}}
        </div>
      </div>

      <!-- Refunded Items Table Section -->
      <div class='section'>
        <div class='header'>Items</div>
        <div class='section-content'>
          <table class='no-borders'>
            <thead>
              <tr>
                <th>Item Name</th>
                <th>Batch No</th>
                <th>Quantity Refunded</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              <!-- Iterating through sections to find refunded items -->
              {{#each sections}}
                {{#if (startsWith title 'Refunded Item')}}
                  <tr>
                    <td>{{content.ItemName}}</td>
                    <td>{{#if
                        content.BatchNo
                      }}{{content.BatchNo}}{{else}}N/A{{/if}}</td>
                    <td>{{#if
                        content.QuantityRefunded
                      }}{{content.QuantityRefunded}}{{else}}N/A{{/if}}</td>
                    <td>{{#if content.AmountRefunded}}{{formatCurrency
                          content.AmountRefunded
                        }}{{else}}N/A{{/if}}</td>
                  </tr>
                {{/if}}
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>