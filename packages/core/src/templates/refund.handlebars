<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; } main { padding: 10mm; display:
      flex; flex-direction: column; flex-grow: 1; } .section { margin-bottom: 20px; } .key-value {
      display: flex; justify-content: space-between; margin-bottom: 10px; } .key { font-weight:
      bold; width: 50%; text-align: left; color: black; } .value { width: 50%; text-align: left;
      white-space: pre-wrap; color: black; } h2 { color:
      {{styles.primaryColor}}; text-align: center; } /* Updated Header Styling */ .header {
      text-align: center; font-size: 18px; font-weight: bold; background: #ffece4; height: 55px;
      display: flex; justify-content: center; align-items: center; margin-bottom: 10px; } /* Table
      Styling */ table { width: 100%; border-collapse: collapse; margin-bottom: 30px; } th, td {
      padding: 8px; text-align: center; } th { background-color: #f9f9f9; color: black; } td {
      color: black; } td.value { color:
      {{styles.primaryColor}}; } .no-borders { border: none; }
    </style>
  </head>
  <body>
    <main>
      <!-- Refund Report Title -->
      <h2>{{reportName}}</h2>

      <div class="divider thin-divider"></div>

      <!-- Refund Details Section -->
      <div class="section">
        <div class="header">Refund Details</div>
        <div class="section-content">
          {{#each sections.0.content}}
            <div class="key-value">
              <span class="key">{{properCase @key}}</span>
              <span class="value">{{this}}</span>
            </div>
          {{/each}}
        </div>
      </div>

      <!-- Refunded Items Table Section -->
      <div class="section">
        <div class="header">Items</div>
        <div class="section-content">
          <table class="no-borders">
            <thead>
              <tr>
                <th>Item Name</th>
                <th>Batch No</th>
                <th>Quantity Refunded</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              <!-- Iterating through sections to find refunded items -->
              {{#each sections}}
                {{#if (startsWith title "Refunded Item")}}
                  <tr>
                    <td>{{content.ItemName}}</td>
                    <td>{{#if content.BatchNo}}{{content.BatchNo}}{{else}}N/A{{/if}}</td>
                    <td>{{#if
                        content.QuantityRefunded
                      }}{{content.QuantityRefunded}}{{else}}N/A{{/if}}</td>
                    <td>{{#if content.AmountRefunded}}{{formatCurrency
                          content.AmountRefunded
                        }}{{else}}N/A{{/if}}</td>
                  </tr>
                {{/if}}
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>